    def four_cols: -> ::Array[FourColsRow]

    private

    def instrument: [T] (::String name) { () -> T } -> T

    def with_client: [T] (::String name) { (untyped) -> T } -> T

    def bound_to: (TransactionConnection connection) -> self

    def execute_statement: (untyped stmt, *untyped params) -> untyped

    def timeout_exits_with_throw?: () -> bool

    def atomically: (untyped client) { () -> void } -> void

    def slice_placeholders: (::Array[untyped] values) -> ::String
  end
end
