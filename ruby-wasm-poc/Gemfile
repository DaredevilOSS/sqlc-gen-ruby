source 'https://rubygems.org'

# Build-time only: used to pack the plugin into ruby.wasm.
gem 'ruby_wasm', '~> 2.7'

group :test do
  # Test-time only (independent protobuf encoder/decoder used by test/fixture.rb).
  # NOT used by the plugin itself - C extensions can't be loaded by ruby.wasm.
  gem 'google-protobuf', '~> 4.0'
  gem 'minitest'
end
