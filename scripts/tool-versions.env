# Versions of the external tools used by the build and CI (sourced by scripts/wasm/build.sh and the workflows).
# The prebuilt ruby.wasm interpreter embedded in dist/plugin.wasm (https://github.com/ruby/ruby.wasm/releases)
RUBY_WASM_VERSION=2.7.1
# sqlc used to generate / diff the examples and to run the plugin
SQLC_VERSION=1.27.0
