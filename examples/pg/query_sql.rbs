    def get_name_case!: (id: ::Integer, class_: ::String, end_: ::String, hash: ::String, method: ::String, count: ::Integer, http_server: ::String, camel_case: ::String, initialize: ::String) -> GetNameCaseRow

    def get_http_server: (id: ::Integer) -> GetHTTPServerRow?

    def get_http_server!: (id: ::Integer) -> GetHTTPServerRow

    def copy_mixed_case_copies: (::Array[CopyMixedCaseCopiesArgs] rows) -> void

    def list_mixed_case_copies: -> ::Array[ListMixedCaseCopiesRow]

    def get_unnamed_columns: -> GetUnnamedColumnsRow?

    def get_unnamed_columns!: -> GetUnnamedColumnsRow

    def get_quoted_alias: -> GetQuotedAliasRow?

    def get_quoted_alias!: -> GetQuotedAliasRow

    def create_exception: -> void

    def count_exceptions: -> CountExceptionsRow?

    def count_exceptions!: -> CountExceptionsRow

    def truncate_exceptions: -> void

    def create_late_feeling: (id: ::Integer, moods: ::Array[::String]) -> void

    def get_late_feeling: (id: ::Integer) -> GetLateFeelingRow?

    def get_late_feeling!: (id: ::Integer) -> GetLateFeelingRow

    def has_authors: -> HasAuthorsRow?

    def has_authors!: -> HasAuthorsRow

    private

    def instrument: [T] (::String name) { () -> T } -> T

    def with_client: [T] (::String name) { (untyped) -> T } -> T

    def bound_to: (TransactionConnection connection) -> self

    def configure: (untyped client) -> void

    def string_arrays: (untyped client) -> untyped

    def run_prepared: (untyped client, ::String name, ::String sql, ?::Array[untyped] params) -> untyped
    def prepare: (untyped client, ::String name, ::String sql) -> void

    def encode_bytea: (::String? value) -> ::String?

    def encode_json: (untyped value) -> untyped

    def encode_timestamp: (untyped value) -> untyped

    def encode_float: (untyped value) -> untyped

    def encode_array: (::Array[untyped]? value, ?::Symbol kind) -> untyped

    def array_elements: (::Array[untyped] values, ::Symbol kind) -> ::Array[untyped]
  end
end
